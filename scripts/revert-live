#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
snap="${1:-$(cat "$root/state/latest-snapshot" 2>/dev/null || true)}"

if [[ -z "$snap" || ! -d "$snap/config" ]]; then
  echo "no snapshot found; pass snapshot path explicitly" >&2
  exit 1
fi

restore_dir() {
  local name="$1"
  local target="$2"
  if [[ -e "$snap/config/$name" ]]; then
    rm -rf "$target"
    cp -a "$snap/config/$name" "$target"
  fi
}

"$root/scripts/stop"
rm -f "$root/state/live-theme-enabled"

restore_dir hypr "$HOME/.config/hypr"
restore_dir waybar "$HOME/.config/waybar"
restore_dir swaync "$HOME/.config/swaync"
restore_dir quickshell "$HOME/.config/quickshell"

old_wall="$(awk '/awww img / {sub(/^.*awww img /, ""); print; exit}' "$snap/state/wallpaper-hints.txt" 2>/dev/null || true)"
if [[ -n "$old_wall" && -f "$old_wall" ]]; then
  pgrep -x awww-daemon >/dev/null 2>&1 || awww-daemon >/tmp/homeshell-awww-revert.log 2>&1 &
  sleep 0.2
  awww img "$old_wall" || true
fi

hyprctl reload || true
echo "reverted from $snap"
