#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WATCH_DIR="$BASE_DIR/quickshell/homeshell"
DEBOUNCE_SEC=2

echo "Watching $WATCH_DIR for changes..."
echo "   Press Ctrl+C to stop."
echo ""

latest_mtime() {
  find "$WATCH_DIR" -type f \( -name '*.qml' -o -name '*.json' \) -printf '%T@\n' 2>/dev/null | sort -nr | sed -n '1p'
}

last_mtime="$(latest_mtime)"
last_mtime="${last_mtime:-0}"

while true; do
  sleep "$DEBOUNCE_SEC"
  current_mtime="$(latest_mtime)"
  current_mtime="${current_mtime:-0}"

  if awk "BEGIN { exit !($current_mtime > $last_mtime) }"; then
    echo ""
    echo "$(date +%H:%M:%S) change detected, reloading shell..."
    "$BASE_DIR/scripts/stop" 2>/dev/null || true
    sleep 0.5
    "$BASE_DIR/scripts/launch"
    echo "Shell restarted."
    echo ""
    echo "Watching for changes..."
    last_mtime="$current_mtime"
  fi
done
