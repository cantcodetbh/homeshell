#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
wallpaper="${1:-$(cat "$root/state/wallpaper" 2>/dev/null || true)}"
mkdir -p "$root/palettes" "$root/state" "$root/theme"

if [[ -z "$wallpaper" || ! -f "$wallpaper" ]]; then
  echo "no wallpaper supplied for theme sync" >&2
  exit 1
fi

printf '%s\n' "$wallpaper" >"$root/state/wallpaper"

if command -v matugen >/dev/null 2>&1; then
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT
  ok=0
  for idx in 0 1 2 3; do
    if matugen image "$wallpaper" --json hex --source-color-index "$idx" --quiet >"$tmp_dir/$idx.raw.json" 2>/tmp/homeshell-matugen.log; then
      sed '${/^ok$/d;}' "$tmp_dir/$idx.raw.json" >"$tmp_dir/$idx.json"
      ok=1
    fi
  done
  if [[ "$ok" != 1 ]]; then
    cat /tmp/homeshell-matugen.log >&2
    exit 1
  fi
  chosen="$(python3 - "$wallpaper" "$tmp_dir" "$root/state/theme-overrides.json" <<'PY'
import colorsys
import json
import math
import sys
import warnings
from collections import Counter
from pathlib import Path

wallpaper = Path(sys.argv[1])
tmp_dir = Path(sys.argv[2])
overrides_path = Path(sys.argv[3])
warnings.filterwarnings("ignore", category=DeprecationWarning)

def hex_to_hsv(hex_color):
    value = hex_color.lstrip("#")
    r = int(value[0:2], 16) / 255
    g = int(value[2:4], 16) / 255
    b = int(value[4:6], 16) / 255
    return colorsys.rgb_to_hsv(r, g, b)

def hue_distance(a, b):
    diff = abs(a - b)
    return min(diff, 1 - diff)

def dominant_hue():
    try:
        from PIL import Image
        img = Image.open(wallpaper).convert("RGB")
        img.thumbnail((180, 120))
    except Exception:
        return None

    buckets = Counter()
    samples = {}
    for r, g, b in img.getdata():
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s < 0.18 or v < 0.12:
            continue
        bucket = int(h * 36) % 36
        weight = s * v
        buckets[bucket] += weight
        if bucket not in samples or weight > samples[bucket][0]:
            samples[bucket] = (weight, h)
    if not buckets:
        return None
    return samples[buckets.most_common(1)[0][0]][1]

try:
    overrides = json.loads(overrides_path.read_text())
    override = overrides.get(str(wallpaper.resolve()), {}) if isinstance(overrides, dict) else {}
except Exception:
    override = {}

if override.get("mode") in ("source-index", "source-variant"):
    override_idx = int(override.get("source_index"))
    override_path = tmp_dir / f"{override_idx}.json"
    if override_path.exists():
        print(f"{override_idx} {override_path}")
        raise SystemExit(0)

target_hue = dominant_hue()
candidates = []
candidate_paths = [path for path in tmp_dir.glob("*.json") if path.stem.isdigit()]
for path in sorted(candidate_paths, key=lambda p: int(p.stem)):
    try:
        data = json.loads(path.read_text())
        primary = data["colors"]["primary"]["dark"]["color"]
        h, s, v = hex_to_hsv(primary)
    except Exception:
        continue
    idx = int(path.stem)
    score = idx if target_hue is None else (hue_distance(h, target_hue) * 1000) - (s * 15) - (v * 5) + (idx * 0.01)
    candidates.append((score, idx, path))

if not candidates:
    raise SystemExit(1)

_, idx, path = min(candidates)
print(f"{idx} {path}")
PY
)"
  chosen_idx="${chosen%% *}"
  chosen_file="${chosen#* }"
  cp "$chosen_file" "$root/palettes/matugen-current.json"
  printf '%s\n' "$chosen_idx" >"$root/palettes/matugen-source-index"
  python3 - "$wallpaper" "$tmp_dir" "$chosen_idx" "$root/state/theme-candidates.json" "$root/state/theme-overrides.json" <<'PY'
import colorsys
import json
import sys
import warnings
from pathlib import Path

wallpaper = str(Path(sys.argv[1]).resolve())
tmp_dir = Path(sys.argv[2])
selected_index = int(sys.argv[3])
out_path = Path(sys.argv[4])
overrides_path = Path(sys.argv[5])
warnings.filterwarnings("ignore", category=DeprecationWarning)

try:
    overrides = json.loads(overrides_path.read_text())
    override = overrides.get(wallpaper, {}) if isinstance(overrides, dict) else {}
except Exception:
    override = {}

def hex_to_rgb(hex_color):
    value = hex_color.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))

def rgb_to_hex(rgb):
    return "#" + "".join(f"{max(0, min(255, round(part))):02x}" for part in rgb)

def shift_hex(hex_color, sat_mult=1.0, value_mult=1.0):
    r, g, b = hex_to_rgb(hex_color)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    s = max(0, min(1, s * sat_mult))
    v = max(0, min(1, v * value_mult))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return rgb_to_hex((rr * 255, gg * 255, bb * 255))

def vivid_hex(hex_color, sat_mult=1.25, min_value=0.70):
    r, g, b = hex_to_rgb(hex_color)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    s = max(0.58, min(1, s * sat_mult))
    v = max(min_value, min(0.96, v * 1.10))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return rgb_to_hex((rr * 255, gg * 255, bb * 255))

def rotate_hex(hex_color, hue_offset, sat_mult=1.0, value_mult=1.0):
    r, g, b = hex_to_rgb(hex_color)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    h = (h + hue_offset) % 1
    s = max(0, min(1, s * sat_mult))
    v = max(0, min(1, v * value_mult))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return rgb_to_hex((rr * 255, gg * 255, bb * 255))

def mix_hex(first, second, second_weight):
    a = hex_to_rgb(first)
    b = hex_to_rgb(second)
    return rgb_to_hex(tuple((a[i] * (1 - second_weight)) + (b[i] * second_weight) for i in range(3)))

def candidate_row(idx, variant, colors):
    suffix = "" if variant == "natural" else f"/{variant}"
    primary = colors["primary"]["dark"]["color"]
    secondary = colors["secondary"]["dark"]["color"]
    tertiary = colors["tertiary"]["dark"]["color"]
    if variant == "strong":
        primary = shift_hex(primary, 1.42, 1.07)
        secondary = shift_hex(secondary, 1.32, 1.05)
        tertiary = shift_hex(tertiary, 1.38, 1.06)
    return {
        "id": f"{idx}{suffix}",
        "index": f"{idx}{suffix}",
        "source_index": idx,
        "variant": variant,
        "label": f"source {idx}{suffix}",
        "primary": primary,
        "secondary": secondary,
        "tertiary": tertiary,
        "surface": colors["surface"]["dark"]["color"],
        "text": colors["on_surface"]["dark"]["color"],
    }

def hue_distance(first, second):
    diff = abs(first - second)
    return min(diff, 1 - diff)

def diverse_samples(samples, limit):
    chosen = []
    for sample in samples:
        if all(hue_distance(sample["h"], other["h"]) >= 0.13 for other in chosen):
            chosen.append(sample)
        if len(chosen) >= limit:
            return chosen
    for sample in samples:
        if sample not in chosen:
            chosen.append(sample)
        if len(chosen) >= limit:
            return chosen
    return chosen

def wildcard_theme_colors(primary, secondary, tertiary, wildcard_idx=0):
    base_roles = [
        (primary, secondary, tertiary, 0.38, 0.32),
        (secondary, tertiary, primary, 0.34, 0.44),
        (tertiary, primary, secondary, 0.30, 0.38),
    ]
    base_a, base_b, base_c, base_mix, alt_mix = base_roles[wildcard_idx % len(base_roles)]
    base_seed = mix_hex(base_a, base_b, base_mix)
    base = shift_hex(base_seed, 0.76, 0.22 + (wildcard_idx % 3) * 0.035)
    base_alt = shift_hex(mix_hex(base_seed, base_c, alt_mix), 0.84, 0.31 + (wildcard_idx % 3) * 0.035)
    text = shift_hex(mix_hex(primary, "#ffffff", 0.78), 0.42, 1.0)
    muted = shift_hex(mix_hex(text, tertiary, 0.30), 0.64, 0.92)
    return {
        "base": base,
        "base_alt": base_alt,
        "text": text,
        "muted": muted,
        "accent": primary,
        "amber": tertiary,
        "red": shift_hex(mix_hex(primary, tertiary, 0.38), 1.08, 0.96),
        "teal": secondary,
    }

def wildcard_candidates(limit=3):
    try:
        from PIL import Image
        img = Image.open(wallpaper).convert("RGB")
        img.thumbnail((220, 140))
    except Exception:
        return []

    buckets = {}
    for r, g, b in img.getdata():
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s < 0.28 or v < 0.16 or v > 0.97:
            continue
        bucket = int(h * 72) % 72
        chroma = s * (0.55 + v)
        current = buckets.get(bucket)
        if current is None or chroma > current["chroma"]:
            buckets[bucket] = {"hex": rgb_to_hex((r, g, b)), "h": h, "chroma": chroma, "count": 0}
        buckets[bucket]["count"] += 1

    if not buckets:
        return []

    max_count = max(item["count"] for item in buckets.values())
    dominant_hue = max(buckets.values(), key=lambda item: item["count"])["h"]
    rare_samples = [
        item for item in buckets.values()
        if item["count"] <= max(3, max_count * 0.18)
    ]
    if len(rare_samples) < limit:
        rare_samples = list(buckets.values())

    samples = sorted(
        rare_samples,
        key=lambda item: (
            (item["chroma"] * 1.35)
            + ((1 - min(1, item["count"] / max_count)) * 0.95)
            + (hue_distance(item["h"], dominant_hue) * 0.55)
        ),
        reverse=True,
    )
    if not samples:
        return []

    seeds = diverse_samples(samples, min(limit + 2, len(samples)))
    rows = []
    for wildcard_idx in range(min(limit, max(1, len(seeds)))):
        seed = seeds[wildcard_idx % len(seeds)]
        secondary_seed = seeds[(wildcard_idx + 1) % len(seeds)]
        tertiary_seed = seeds[(wildcard_idx + 2) % len(seeds)]
        primary = vivid_hex(seed["hex"], 1.18, 0.58)
        secondary = vivid_hex(secondary_seed["hex"], 1.12, 0.52)
        tertiary = vivid_hex(tertiary_seed["hex"], 1.10, 0.52)
        theme_colors = wildcard_theme_colors(primary, secondary, tertiary, wildcard_idx)
        rows.append({
            "id": f"wild/{wildcard_idx}",
            "index": f"wild/{wildcard_idx}",
            "source_index": -1,
            "variant": "wildcard",
            "wildcard_index": wildcard_idx,
            "label": f"wildcard {wildcard_idx}",
            "source_hex": seed["hex"],
            "source_count": seed["count"],
            "primary": primary,
            "secondary": secondary,
            "tertiary": tertiary,
            "surface": theme_colors["base"],
            "text": theme_colors["text"],
            "theme_colors": theme_colors,
        })
    return rows

candidates = []
for path in sorted(tmp_dir.glob("*.json"), key=lambda p: int(p.stem) if p.stem.isdigit() else 999):
    if not path.stem.isdigit():
        continue
    try:
        data = json.loads(path.read_text())
        colors = data["colors"]
        idx = int(path.stem)
        candidates.append(candidate_row(idx, "natural", colors))
        candidates.append(candidate_row(idx, "strong", colors))
    except Exception:
        continue

candidates.extend(wildcard_candidates())

if not candidates:
    raise SystemExit("no valid theme colour candidates generated")

selected_id = str(selected_index)
if override.get("mode") == "source-variant":
    variant = str(override.get("variant", "natural"))
    if variant not in ("natural", "strong"):
        variant = "natural"
    selected_id = f"{selected_index}/{variant}" if variant != "natural" else str(selected_index)
if override.get("mode") == "wildcard-palette":
    selected_id = f"wild/{int(override.get('wildcard_index', 0))}"

selected = next((item for item in candidates if item["id"] == selected_id), {})
if override.get("mode") == "bred-palette":
    parents = override.get("parents", [])
    if isinstance(parents, list) and len(parents) >= 2:
        selected_reason = "bred source {first} + {second} | wallpaper anchored".format(
            first=parents[0],
            second=parents[1],
        )
    else:
        selected_reason = "bred palette | wallpaper anchored"
elif override.get("mode") == "wildcard-palette":
    selected_reason = "{label} | wallpaper odd colours | {count} choices".format(
        label=selected.get("label", selected_id),
        count=len(candidates),
    )
else:
    selected_reason = "{label} | primary {primary} | {count} choices".format(
        label=selected.get("label", f"source {selected_index}"),
        primary=selected.get("primary", "--"),
        count=len(candidates),
    )

out_path.write_text(json.dumps({
    "wallpaper": wallpaper,
    "selected_index": selected_index,
    "selected_id": selected_id,
    "selected_reason": selected_reason,
    "override": override if isinstance(override, dict) else {},
    "candidates": candidates,
}, indent=2) + "\n")
PY
fi

python3 - "$root" "$wallpaper" <<'PY'
import json
import re
import shutil
import sys
import colorsys
from pathlib import Path

root = Path(sys.argv[1])
wallpaper = sys.argv[2]
palette = root / "palettes" / "matugen-current.json"
data = {}
try:
    data = json.loads(palette.read_text())
except Exception:
    data = {}

def find(key, fallback):
    colors = data.get("colors")
    if isinstance(colors, dict):
        value = colors.get(key)
        if isinstance(value, dict):
            for mode in ("dark", "default", "light"):
                mode_value = value.get(mode)
                if isinstance(mode_value, dict) and isinstance(mode_value.get("color"), str):
                    return mode_value["color"]
            if isinstance(value.get("color"), str):
                return value["color"]
        if isinstance(value, str):
            return value

    stack = [data]
    while stack:
        item = stack.pop()
        if isinstance(item, dict):
            if key in item and isinstance(item[key], str):
                return item[key]
            stack.extend(item.values())
        elif isinstance(item, list):
            stack.extend(item)
    return fallback

colors = {
    "base": find("surface", "#1d1715"),
    "base_alt": find("surface_container", "#2b211e"),
    "text": find("on_surface", "#efe4dc"),
    "muted": find("on_surface_variant", "#cdbeb4"),
    "accent": find("primary", "#a8c5c9"),
    "amber": find("tertiary", "#d7a86e"),
    "red": find("error", "#b85f4d"),
    "teal": find("secondary", "#7fa8a2"),
}

try:
    overrides = json.loads((root / "state" / "theme-overrides.json").read_text())
    override = overrides.get(str(Path(wallpaper).resolve()), {}) if isinstance(overrides, dict) else {}
except Exception:
    override = {}

if override.get("mode") == "accent":
    accent = override.get("accent", "")
    if isinstance(accent, str) and re.match(r"^#[0-9a-fA-F]{6}$", accent):
        colors["accent"] = accent.lower()

if override.get("mode") == "bred-palette":
    bred_colors = override.get("colors", {})
    if isinstance(bred_colors, dict):
        for key in ("base", "base_alt", "text", "muted", "accent", "amber", "red", "teal"):
            value = bred_colors.get(key)
            if isinstance(value, str) and re.match(r"^#[0-9a-fA-F]{6}$", value):
                colors[key] = value.lower()

def rgb_tuple(hex_color):
    value = hex_color.lstrip("#")
    return f"{int(value[0:2], 16)}, {int(value[2:4], 16)}, {int(value[4:6], 16)}"

def mix_hex(first, second, second_weight):
    first_value = first.lstrip("#")
    second_value = second.lstrip("#")
    parts = []
    for idx in (0, 2, 4):
        a = int(first_value[idx:idx + 2], 16)
        b = int(second_value[idx:idx + 2], 16)
        parts.append(round((a * (1 - second_weight)) + (b * second_weight)))
    return "#" + "".join(f"{part:02x}" for part in parts)

def shift_hex(hex_color, sat_mult=1.0, value_mult=1.0):
    value = hex_color.lstrip("#")
    r = int(value[0:2], 16) / 255
    g = int(value[2:4], 16) / 255
    b = int(value[4:6], 16) / 255
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    s = max(0, min(1, s * sat_mult))
    v = max(0, min(1, v * value_mult))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return "#" + "".join(f"{round(channel * 255):02x}" for channel in (rr, gg, bb))

def apply_color_override(override_colors):
    if isinstance(override_colors, dict):
        for key in ("base", "base_alt", "text", "muted", "accent", "amber", "red", "teal"):
            value = override_colors.get(key)
            if isinstance(value, str) and re.match(r"^#[0-9a-fA-F]{6}$", value):
                colors[key] = value.lower()

if override.get("mode") == "source-variant" and override.get("variant") == "strong":
    colors["accent"] = shift_hex(colors["accent"], 1.42, 1.07)
    colors["teal"] = shift_hex(colors["teal"], 1.32, 1.05)
    colors["amber"] = shift_hex(colors["amber"], 1.38, 1.06)
    colors["red"] = shift_hex(colors["red"], 1.20, 1.04)

if override.get("mode") == "wildcard-palette":
    apply_color_override(override.get("colors", {}))

border_accent = mix_hex(colors["accent"], colors["muted"], 0.42)
border_secondary = mix_hex(colors["teal"], colors["muted"], 0.48)
colors["border_accent"] = border_accent

(root / "theme" / "current.json").write_text(json.dumps({"wallpaper": wallpaper, "colors": colors}, indent=2) + "\n")
(root / "theme" / "current.conf").write_text(
    "\n".join(
        [
            "# Generated by HomeShell sync-theme",
            f"$homeshell_base = rgb({colors['base'].lstrip('#')})",
            f"$homeshell_accent = rgb({colors['accent'].lstrip('#')})",
            f"$homeshell_text = rgb({colors['text'].lstrip('#')})",
            "",
        ]
    )
)
(root / "theme" / "hyprland-live.conf").write_text(
    "\n".join(
        [
            "# Generated by HomeShell sync-theme",
            f"$homeshell_base = rgb({colors['base'].lstrip('#')})",
            f"$homeshell_base_alt = rgb({colors['base_alt'].lstrip('#')})",
            f"$homeshell_text = rgb({colors['text'].lstrip('#')})",
            f"$homeshell_muted = rgb({colors['muted'].lstrip('#')})",
            f"$homeshell_accent = rgb({colors['accent'].lstrip('#')})",
            f"$homeshell_border_accent = rgba({border_accent.lstrip('#')}dd)",
            f"$homeshell_red = rgb({colors['red'].lstrip('#')})",
            "",
            "general {",
            "    border_size = 3",
            f"    col.active_border = rgba({border_accent.lstrip('#')}dd)",
            f"    col.inactive_border = rgba({border_accent.lstrip('#')}6b)",
            "}",
            "",
            "group {",
            f"    col.border_active = rgba({border_accent.lstrip('#')}dd) rgba({border_secondary.lstrip('#')}cc) 45deg",
            f"    col.border_inactive = rgba({border_accent.lstrip('#')}6b)",
            f"    col.border_locked_active = rgba({colors['amber'].lstrip('#')}ff)",
            f"    col.border_locked_inactive = rgba({border_accent.lstrip('#')}6b)",
            "}",
            "",
        ]
    )
)
(root / "theme" / "hyprlock-pixie-colors.conf").write_text(
    "\n".join(
        [
            "# Generated by HomeShell sync-theme",
            f"$homeshell_lock_text = rgba({rgb_tuple(colors['accent'])}, 0.96)",
            f"$homeshell_lock_text_soft = rgba({rgb_tuple(colors['muted'])}, 0.72)",
            f"$homeshell_lock_input_text = rgba({rgb_tuple(colors['text'])}, 0.90)",
            f"$homeshell_lock_fail_text = rgba({rgb_tuple(colors['red'])}, 0.88)",
            f"$homeshell_lock_accent_clear = rgba({rgb_tuple(colors['accent'])}, 0)",
            "",
        ]
    )
)
(root / "theme" / "current.css").write_text(
    ":root {\n"
    + "\n".join(f"  --homeshell-{key}: {value};" for key, value in colors.items())
    + "\n}\n"
)

icon_src_dir = root / "assets" / "meteocons" / "fill-animated"
icon_out_dir = root / "theme" / "meteocons"
icon_out_dir.mkdir(parents=True, exist_ok=True)

def tint_icon(raw_icon, icon_color):
    tinted = raw_icon.replace("currentColor", icon_color)
    tinted = re.sub(r'fill="#[0-9a-fA-F]{6}"', f'fill="{icon_color}"', tinted)
    tinted = re.sub(r'stroke="#[0-9a-fA-F]{6}"', f'stroke="{icon_color}"', tinted)
    tinted = re.sub(r'fill="url\([^)]+\)"', f'fill="{icon_color}"', tinted)
    tinted = re.sub(r'stroke="url\([^)]+\)"', f'stroke="{icon_color}"', tinted)
    tinted = re.sub(r'stop-color="#[0-9a-fA-F]{6}"', f'stop-color="{icon_color}"', tinted)
    return tinted

def settle_cloud(raw_icon):
    return re.sub(
        r'<animateTransform[^>]*type="translate"[^>]*values="0 0;0 -3;0 0"[^>]*/>',
        "",
        raw_icon,
    )

for icon_path in icon_src_dir.glob("*.svg"):
    raw_icon = settle_cloud(icon_path.read_text())
    icon_out_dir.joinpath(icon_path.name).write_text(tint_icon(raw_icon, colors["muted"]))
    icon_out_dir.joinpath(icon_path.name.replace(".svg", "-active.svg")).write_text(tint_icon(raw_icon, colors["accent"]))

(root / "theme" / "waybar-live.css").write_text(
    "/* Generated by HomeShell sync-theme */\n"
    + "\n".join(
        [
            f"@define-color background {colors['base']};",
            f"@define-color surface {colors['base_alt']};",
            f"@define-color foreground {colors['text']};",
            f"@define-color muted {colors['muted']};",
            f"@define-color primary {colors['accent']};",
            f"@define-color secondary {colors['teal']};",
            f"@define-color warning {colors['amber']};",
            f"@define-color error {colors['red']};",
            "",
        ]
    )
)
(root / "theme" / "swaync-live.css").write_text(
    "/* Generated by HomeShell sync-theme */\n"
    f"@define-color cc-bg rgba({rgb_tuple(colors['base'])}, 0.86);\n"
    f"@define-color noti-bg {colors['base_alt']};\n"
    f"@define-color noti-border-color {colors['accent']};\n"
    f"@define-color text-color {colors['text']};\n"
    f"@define-color text-color-disabled {colors['muted']};\n"
)
(root / "theme" / "gtk-live.css").write_text(
    "/* Generated by HomeShell sync-theme */\n"
    f"@define-color theme_bg_color {colors['base']};\n"
    f"@define-color theme_fg_color {colors['text']};\n"
    f"@define-color theme_selected_bg_color {colors['accent']};\n"
    f"@define-color theme_selected_fg_color {colors['base']};\n"
    f"@define-color borders {colors['muted']};\n"
)

# Rofi: dynamic HomeShell variables (used by select configs).
def rgba(hex_color: str, alpha: float) -> str:
    value = hex_color.lstrip("#")
    r = int(value[0:2], 16)
    g = int(value[2:4], 16)
    b = int(value[4:6], 16)
    # Keep alpha short and stable for diffs.
    a = f"{alpha:.2f}".rstrip("0").rstrip(".")
    return f"rgba({r}, {g}, {b}, {a})"

(root / "theme" / "rofi-homeshell-colors.rasi").write_text(
    "\n".join(
        [
            "/* Generated by HomeShell sync-theme */",
            "* {",
            f"    ba-bg:          {rgba(colors['base'], 0.84)};",
            f"    ba-bg-soft:     {rgba(colors['base_alt'], 0.78)};",
            f"    ba-bg-hover:    {rgba(colors['teal'], 0.42)};",
            f"    ba-bar:         {rgba(colors['teal'], 0.54)};",
            f"    ba-accent:      {colors['accent']};",
            f"    ba-accent-dark: {colors['teal']};",
            f"    ba-fg:          {colors['text']};",
            f"    ba-muted:       {colors['muted']};",
            "    ba-border-width: 4px;",
            "}",
            "",
        ]
    )
)

sddm_theme = Path("/usr/share/sddm/themes/pixie")
if sddm_theme.exists():
    try:
        shutil.copyfile(wallpaper, sddm_theme / "assets" / "background.jpg")
        (sddm_theme / "theme.conf").write_text(
            "\n".join(
                [
                    "[General]",
                    "# Path to the wallpaper. If it's in the assets folder, use \"assets/background.jpg\"",
                    "background=assets/background.jpg",
                    "",
                    "# Generated from the current HomeShell wallpaper theme",
                    f"primaryColor={colors['text']}",
                    f"accentColor={colors['accent']}",
                    "autoColor=true",
                    "use24HourClock=true",
                    f"backgroundColor={colors['base']}",
                    f"textColor={colors['text']}",
                    "",
                    "# Font settings",
                    "fontFamily=FlexRounded",
                    "fontSize=12",
                    "",
                ]
            )
        )
    except Exception as exc:
        print(f"warning: could not update Pixie SDDM theme: {exc}", file=sys.stderr)
PY

if [[ -f "$root/state/live-theme-enabled" ]]; then
  "$root/scripts/apply-theme-live" || true
fi

quickshell ipc --path "$root/quickshell/homeshell" --any-display call shell refresh >/dev/null 2>&1 || true

echo "theme synced from $wallpaper"
