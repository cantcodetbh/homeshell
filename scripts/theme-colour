#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state="$root/state/wallpaper"
overrides="$root/state/theme-overrides.json"
mode="${1:-pick}"
extra="${2:-}"
wallpaper="${2:-$(cat "$state" 2>/dev/null || true)}"

case "$mode" in
  set-index|set-accent)
    wallpaper="${3:-$(cat "$state" 2>/dev/null || true)}"
    ;;
  breed)
    wallpaper="${4:-$(cat "$state" 2>/dev/null || true)}"
    ;;
esac

mkdir -p "$root/state"

if [[ -z "$wallpaper" || ! -f "$wallpaper" ]]; then
  echo "no current wallpaper found" >&2
  exit 1
fi

python3 - "$root" "$wallpaper" "$mode" "${@:2}" <<'PY'
import json
import re
import subprocess
import sys
import tempfile
import colorsys
import warnings
from pathlib import Path

root = Path(sys.argv[1])
wallpaper = str(Path(sys.argv[2]).resolve())
mode = sys.argv[3]
args = sys.argv[4:]
extra = args[0] if args else ""
overrides_path = root / "state" / "theme-overrides.json"
warnings.filterwarnings("ignore", category=DeprecationWarning)

def load_overrides():
    try:
        data = json.loads(overrides_path.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}

def save_overrides(data):
    overrides_path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")

def matugen_candidates():
    rows = []
    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)
        for idx in range(4):
            proc = subprocess.run(
                ["matugen", "image", wallpaper, "--json", "hex", "--source-color-index", str(idx), "--quiet"],
                text=True,
                capture_output=True,
            )
            if proc.returncode != 0:
                continue
            raw = "\n".join(line for line in proc.stdout.splitlines() if line != "ok")
            try:
                data = json.loads(raw)
                colors = data["colors"]
                primary = colors["primary"]["dark"]["color"]
                secondary = colors["secondary"]["dark"]["color"]
                tertiary = colors["tertiary"]["dark"]["color"]
            except Exception:
                continue
            rows.append({
                "id": str(idx),
                "source_index": idx,
                "variant": "natural",
                "primary": primary,
                "secondary": secondary,
                "tertiary": tertiary,
            })
            rows.append({
                "id": f"{idx}/strong",
                "source_index": idx,
                "variant": "strong",
                "primary": strengthen_hex(primary, 1.42, 1.07),
                "secondary": strengthen_hex(secondary, 1.32, 1.05),
                "tertiary": strengthen_hex(tertiary, 1.38, 1.06),
            })
    return rows

def matugen_palette_map():
    palettes = {}
    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)
        for idx in range(4):
            proc = subprocess.run(
                ["matugen", "image", wallpaper, "--json", "hex", "--source-color-index", str(idx), "--quiet"],
                text=True,
                capture_output=True,
            )
            if proc.returncode != 0:
                continue
            raw = "\n".join(line for line in proc.stdout.splitlines() if line != "ok")
            try:
                palettes[idx] = json.loads(raw)
            except Exception:
                continue
    return palettes

def rofi_choice(options, prompt):
    proc = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", prompt],
        input="\n".join(options) + "\n",
        text=True,
        capture_output=True,
    )
    return proc.stdout.strip() if proc.returncode == 0 else ""

def apply_sync():
    subprocess.run([str(root / "scripts" / "sync-theme"), wallpaper], check=True)

def hex_to_rgb(hex_color):
    value = hex_color.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))

def rgb_to_hex(rgb):
    return "#" + "".join(f"{max(0, min(255, round(part))):02x}" for part in rgb)

def mix_hex(first, second, second_weight):
    a = hex_to_rgb(first)
    b = hex_to_rgb(second)
    return rgb_to_hex(tuple((a[i] * (1 - second_weight)) + (b[i] * second_weight) for i in range(3)))

def shift_hex(hex_color, sat_mult=1.0, value_mult=1.0):
    r, g, b = hex_to_rgb(hex_color)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    s = max(0, min(1, s * sat_mult))
    v = max(0, min(1, v * value_mult))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return rgb_to_hex((rr * 255, gg * 255, bb * 255))

def strengthen_hex(hex_color, sat_mult=1.35, value_mult=1.06):
    return shift_hex(hex_color, sat_mult, value_mult)

def vivid_hex(hex_color, sat_mult=1.25, min_value=0.70):
    r, g, b = hex_to_rgb(hex_color)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    s = max(0.58, min(1, s * sat_mult))
    v = max(min_value, min(0.96, v * 1.10))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return rgb_to_hex((rr * 255, gg * 255, bb * 255))

def rotate_hex(hex_color, hue_offset, sat_mult=1.0, value_mult=1.0):
    r, g, b = hex_to_rgb(hex_color)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    h = (h + hue_offset) % 1
    s = max(0, min(1, s * sat_mult))
    v = max(0, min(1, v * value_mult))
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, v)
    return rgb_to_hex((rr * 255, gg * 255, bb * 255))

def hue_distance(first, second):
    diff = abs(first - second)
    return min(diff, 1 - diff)

def diverse_samples(samples, limit):
    chosen = []
    for sample in samples:
        if all(hue_distance(sample["h"], other["h"]) >= 0.13 for other in chosen):
            chosen.append(sample)
        if len(chosen) >= limit:
            return chosen
    for sample in samples:
        if sample not in chosen:
            chosen.append(sample)
        if len(chosen) >= limit:
            return chosen
    return chosen

def wildcard_theme_colors(primary, secondary, tertiary, wildcard_idx=0):
    base_roles = [
        (primary, secondary, tertiary, 0.38, 0.32),
        (secondary, tertiary, primary, 0.34, 0.44),
        (tertiary, primary, secondary, 0.30, 0.38),
    ]
    base_a, base_b, base_c, base_mix, alt_mix = base_roles[wildcard_idx % len(base_roles)]
    base_seed = mix_hex(base_a, base_b, base_mix)
    base = shift_hex(base_seed, 0.76, 0.22 + (wildcard_idx % 3) * 0.035)
    base_alt = shift_hex(mix_hex(base_seed, base_c, alt_mix), 0.84, 0.31 + (wildcard_idx % 3) * 0.035)
    text = shift_hex(mix_hex(primary, "#ffffff", 0.78), 0.42, 1.0)
    muted = shift_hex(mix_hex(text, tertiary, 0.30), 0.64, 0.92)
    return {
        "base": base,
        "base_alt": base_alt,
        "text": text,
        "muted": muted,
        "accent": primary,
        "amber": tertiary,
        "red": shift_hex(mix_hex(primary, tertiary, 0.38), 1.08, 0.96),
        "teal": secondary,
    }

def wildcard_candidates(limit=3):
    try:
        from PIL import Image
        img = Image.open(wallpaper).convert("RGB")
        img.thumbnail((220, 140))
    except Exception:
        return []

    buckets = {}
    for r, g, b in img.getdata():
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s < 0.28 or v < 0.16 or v > 0.97:
            continue
        bucket = int(h * 72) % 72
        chroma = s * (0.55 + v)
        current = buckets.get(bucket)
        if current is None or chroma > current["chroma"]:
            buckets[bucket] = {"hex": rgb_to_hex((r, g, b)), "h": h, "s": s, "v": v, "chroma": chroma, "count": 0}
        buckets[bucket]["count"] += 1

    if not buckets:
        return []

    max_count = max(item["count"] for item in buckets.values())
    dominant_hue = max(buckets.values(), key=lambda item: item["count"])["h"]
    rare_samples = [
        item for item in buckets.values()
        if item["count"] <= max(3, max_count * 0.18)
    ]
    if len(rare_samples) < limit:
        rare_samples = list(buckets.values())

    samples = sorted(
        rare_samples,
        key=lambda item: (
            (item["chroma"] * 1.35)
            + ((1 - min(1, item["count"] / max_count)) * 0.95)
            + (hue_distance(item["h"], dominant_hue) * 0.55)
        ),
        reverse=True,
    )
    if not samples:
        return []

    seeds = diverse_samples(samples, min(limit + 2, len(samples)))
    rows = []
    for wildcard_idx in range(min(limit, max(1, len(seeds)))):
        seed = seeds[wildcard_idx % len(seeds)]
        secondary_seed = seeds[(wildcard_idx + 1) % len(seeds)]
        tertiary_seed = seeds[(wildcard_idx + 2) % len(seeds)]
        primary = vivid_hex(seed["hex"], 1.18, 0.58)
        secondary = vivid_hex(secondary_seed["hex"], 1.12, 0.52)
        tertiary = vivid_hex(tertiary_seed["hex"], 1.10, 0.52)
        theme_colors = wildcard_theme_colors(primary, secondary, tertiary, wildcard_idx)
        rows.append({
            "id": f"wild/{wildcard_idx}",
            "source_index": -1,
            "variant": "wildcard",
            "wildcard_index": wildcard_idx,
            "label": f"wildcard {wildcard_idx}",
            "source_hex": seed["hex"],
            "source_count": seed["count"],
            "primary": primary,
            "secondary": secondary,
            "tertiary": tertiary,
            "surface": theme_colors["base"],
            "text": theme_colors["text"],
            "theme_colors": theme_colors,
        })
    return rows

def wildcard_colors(row):
    colors = row.get("theme_colors")
    if isinstance(colors, dict):
        return colors
    return wildcard_theme_colors(row["primary"], row["secondary"], row["tertiary"])

def palette_color(data, key, fallback):
    colors = data.get("colors", {}) if isinstance(data, dict) else {}
    value = colors.get(key)
    if isinstance(value, dict):
        for mode_name in ("dark", "default", "light"):
            mode_value = value.get(mode_name)
            if isinstance(mode_value, dict) and isinstance(mode_value.get("color"), str):
                return mode_value["color"]
        if isinstance(value.get("color"), str):
            return value["color"]
    if isinstance(value, str):
        return value
    return fallback

def candidate_label(row):
    if row.get("variant") == "wildcard":
        return (
            f"{row.get('label', row['id'])}: "
            f"primary {row['primary']} | secondary {row['secondary']} | tertiary {row['tertiary']}"
        )
    suffix = "" if row.get("variant") == "natural" else f"/{row.get('variant')}"
    return (
        f"source {row['source_index']}{suffix}: "
        f"primary {row['primary']} | secondary {row['secondary']} | tertiary {row['tertiary']}"
    )

def parse_source_choice(choice):
    match = re.match(r"source\s+(\d+)(?:/([a-z0-9_-]+))?:", choice or "")
    if not match:
        return None, "natural"
    return int(match.group(1)), match.group(2) or "natural"

def parse_palette_token(token):
    wild_match = re.match(r"^wild/(\d+)$", token or "")
    if wild_match:
        return "wild", int(wild_match.group(1))
    match = re.match(r"^(\d+)(?:/([a-z0-9_-]+))?$", token or "")
    if not match:
        return None, "natural"
    variant = match.group(2) or "natural"
    if variant not in ("natural", "strong"):
        return None, "natural"
    return int(match.group(1)), variant

def breed_palette(parent_a, parent_b, anchor):
    role_fallbacks = {
        "surface": "#1d1715",
        "surface_container": "#2b211e",
        "on_surface": "#efe4dc",
        "on_surface_variant": "#cdbeb4",
        "primary": "#a8c5c9",
        "tertiary": "#d7a86e",
        "error": "#b85f4d",
        "secondary": "#7fa8a2",
    }
    role_bias = {
        "surface": 0.72,
        "surface_container": 0.66,
        "on_surface": 0.68,
        "on_surface_variant": 0.58,
        "primary": 0.34,
        "secondary": 0.38,
        "tertiary": 0.40,
        "error": 0.50,
    }
    child = {}
    for key, fallback in role_fallbacks.items():
        a = palette_color(parent_a, key, fallback)
        b = palette_color(parent_b, key, fallback)
        base = palette_color(anchor, key, fallback)
        bred = mix_hex(a, b, 0.5)
        child[key] = mix_hex(bred, base, role_bias.get(key, 0.42))
    child["primary"] = shift_hex(child["primary"], 1.10, 1.04)
    child["secondary"] = shift_hex(child["secondary"], 1.04, 1.02)
    child["tertiary"] = shift_hex(child["tertiary"], 1.08, 1.03)
    child["error"] = shift_hex(child["error"], 1.05, 1.03)
    return {
        "base": child["surface"],
        "base_alt": child["surface_container"],
        "text": child["on_surface"],
        "muted": child["on_surface_variant"],
        "accent": child["primary"],
        "amber": child["tertiary"],
        "red": child["error"],
        "teal": child["secondary"],
    }

overrides = load_overrides()

if mode == "clear":
    if wallpaper in overrides:
        del overrides[wallpaper]
        save_overrides(overrides)
    apply_sync()
    print(f"cleared theme colour override for {Path(wallpaper).name}")
    raise SystemExit(0)

if mode == "show":
    print(json.dumps(overrides.get(wallpaper, {}), indent=2))
    raise SystemExit(0)

if mode == "set-index":
    idx, variant = parse_palette_token(extra)
    if idx is None:
        raise SystemExit("usage: theme-colour set-index INDEX[/VARIANT]|wild/N [WALLPAPER]")
    if idx == "wild":
        wildcards = wildcard_candidates()
        row = next((item for item in wildcards if item.get("wildcard_index") == variant), None)
        if row is None:
            raise SystemExit("invalid wildcard palette")
        overrides[wallpaper] = {
            "mode": "wildcard-palette",
            "wildcard_index": variant,
            "colors": wildcard_colors(row),
        }
    elif variant == "natural":
        overrides[wallpaper] = {"mode": "source-index", "source_index": idx}
    else:
        overrides[wallpaper] = {"mode": "source-variant", "source_index": idx, "variant": variant}
    save_overrides(overrides)
    apply_sync()
    label = f"wild/{variant}" if idx == "wild" else f"{idx}{'' if variant == 'natural' else '/' + variant}"
    print(f"set source {label} for {Path(wallpaper).name}")
    raise SystemExit(0)

if mode == "set-accent":
    accent = extra.strip()
    if not re.match(r"^#[0-9a-fA-F]{6}$", accent):
        raise SystemExit("accent must be #RRGGBB")
    overrides[wallpaper] = {"mode": "accent", "accent": accent.lower()}
    save_overrides(overrides)
    apply_sync()
    print(f"set custom accent {accent.lower()} for {Path(wallpaper).name}")
    raise SystemExit(0)

if mode == "breed":
    palettes = matugen_palette_map()
    if len(palettes) < 2:
        raise SystemExit("not enough theme palettes to breed")
    rows = matugen_candidates()
    row_options = [candidate_label(row) for row in rows if row["variant"] == "natural" and row["source_index"] in palettes]
    if len(args) >= 2:
        try:
            first_idx = int(args[0])
            second_idx = int(args[1])
        except Exception:
            raise SystemExit("usage: theme-colour breed [FIRST_INDEX SECOND_INDEX] [WALLPAPER]")
    else:
        first_choice = rofi_choice(row_options, "breed parent A") if Path("/usr/bin/rofi").exists() else ""
        second_choice = rofi_choice(row_options, "breed parent B") if Path("/usr/bin/rofi").exists() else ""
        first_idx, _ = parse_source_choice(first_choice)
        second_idx, _ = parse_source_choice(second_choice)
    if first_idx not in palettes or second_idx not in palettes:
        raise SystemExit("invalid breed parent selection")
    anchor_idx = min(palettes.keys())
    child_colors = breed_palette(palettes[first_idx], palettes[second_idx], palettes[anchor_idx])
    overrides[wallpaper] = {
        "mode": "bred-palette",
        "parents": [first_idx, second_idx],
        "anchor_index": anchor_idx,
        "colors": child_colors,
    }
    save_overrides(overrides)
    apply_sync()
    print(f"bred sources {first_idx} + {second_idx} for {Path(wallpaper).name}")
    raise SystemExit(0)

if mode != "pick":
    raise SystemExit("usage: theme-colour [pick|breed|clear|show|set-index|set-accent]")

rows = matugen_candidates() + wildcard_candidates()
options = [
    candidate_label(row)
    for row in rows
]
options.append("breed palette: select two parents")
options.append("custom accent: enter #RRGGBB")
options.append("clear override")

choice = rofi_choice(options, "theme colour") if Path("/usr/bin/rofi").exists() else ""
if not choice:
    print("no theme colour selected")
    raise SystemExit(1)

if choice == "clear override":
    if wallpaper in overrides:
        del overrides[wallpaper]
        save_overrides(overrides)
    apply_sync()
    print(f"cleared theme colour override for {Path(wallpaper).name}")
    raise SystemExit(0)

if choice.startswith("custom accent:"):
    accent = rofi_choice(["#a8c5c9", "#edc06c", "#87d1eb", "#ffb787", "#a2d398"], "custom #hex")
    if not re.match(r"^#[0-9a-fA-F]{6}$", accent or ""):
        print("invalid accent")
        raise SystemExit(1)
    overrides[wallpaper] = {"mode": "accent", "accent": accent.lower()}
    save_overrides(overrides)
    apply_sync()
    print(f"set custom accent {accent.lower()} for {Path(wallpaper).name}")
    raise SystemExit(0)

if choice.startswith("breed palette:"):
    options = [candidate_label(row) for row in rows if row["variant"] == "natural"]
    first_choice = rofi_choice(options, "breed parent A")
    second_choice = rofi_choice(options, "breed parent B")
    first_idx, _ = parse_source_choice(first_choice)
    second_idx, _ = parse_source_choice(second_choice)
    if first_idx is None or second_idx is None:
        print("invalid breed selection")
        raise SystemExit(1)
    subprocess.run([str(root / "scripts" / "theme-colour"), "breed", str(first_idx), str(second_idx), wallpaper], check=True)
    raise SystemExit(0)

idx, variant = parse_source_choice(choice)
if idx is None and choice.startswith("wildcard "):
    match = re.match(r"wildcard\s+(\d+):", choice)
    idx = "wild"
    variant = int(match.group(1)) if match else None
if idx is None or variant is None:
    print("invalid selection")
    raise SystemExit(1)

if idx == "wild":
    row = next((item for item in rows if item.get("wildcard_index") == variant), None)
    if row is None:
        print("invalid wildcard selection")
        raise SystemExit(1)
    overrides[wallpaper] = {
        "mode": "wildcard-palette",
        "wildcard_index": variant,
        "colors": wildcard_colors(row),
    }
elif variant == "natural":
    overrides[wallpaper] = {"mode": "source-index", "source_index": idx}
else:
    overrides[wallpaper] = {"mode": "source-variant", "source_index": idx, "variant": variant}
save_overrides(overrides)
apply_sync()
label = f"wild/{variant}" if idx == "wild" else f"{idx}{'' if variant == 'natural' else '/' + variant}"
print(f"set source {label} for {Path(wallpaper).name}")
PY
